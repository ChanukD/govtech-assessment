# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
venv*/

# Node / frontend tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
coverage/
.next/
out/

# Terraform
# .terraform/ caches downloaded provider binaries — the AWS provider alone is ~776 MB.
# Never commit it. .terraform.lock.hcl lives outside that directory and IS committed:
# it pins the provider versions and their checksums.
**/.terraform/*

# State is held remotely in S3 (see infra/envs/dev/backend.tf) and records resource
# attributes that can be sensitive, so it never belongs in git.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved plans are binary artifacts and can contain secret values in plaintext.
*.tfplan
*.tfplan.*

# Crash logs and machine-local CLI overrides
crash.log
crash.*.log
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# infra/envs/dev/terraform.tfvars is committed deliberately — it holds no secrets. The
# only credential in the stack is generated by random_password directly into Secrets
# Manager. Machine-local and secret-bearing variable files are still excluded.
*.auto.tfvars
*.local.tfvars
secrets.tfvars

# Temporary and generated files
*.log
tmp/
temp/
*.tmp
*.bak

# Local OS files
._*
