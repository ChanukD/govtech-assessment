# Copy to .env and adjust. Nothing here is a secret in local development.
PIPELINE_DATABASE_PATH=./pipeline.db
PIPELINE_SOURCE_FILE=../data/records.csv

# Local stand-in for the SQS visibility timeout: how long a claimed run stays
# invisible to other workers before it can be re-claimed.
PIPELINE_VISIBILITY_TIMEOUT_SECONDS=30

# Equivalent of SQS maxReceiveCount. On the final failure the run is marked FAILED,
# which is this design's dead-letter queue.
PIPELINE_MAX_ATTEMPTS=3

# Worker poll interval. SQS long-polling collapses this to a blocking receive.
PIPELINE_POLL_INTERVAL_SECONDS=1.0

PIPELINE_CORS_ORIGINS=http://localhost:5173
